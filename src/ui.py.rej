+    def _show_change_my_password(self) -> None:
+        user = self.security_service._current_user
+        if not user:
+            self._show_error("Nenhum usu├írio logado.")
+            return
+
+        pwd_dlg = ctk.CTkToplevel(self)
+        pwd_dlg.title("Trocar Minha Senha")
+        pwd_dlg.geometry("400x250")
+        pwd_dlg.grab_set()
+
+        ctk.CTkLabel(pwd_dlg, text="Nova Senha").pack(pady=(20, 5))
+        pwd_entry = ctk.CTkEntry(pwd_dlg, width=250, show="*")
+        pwd_entry.pack()
+
+        def save():
+            new_pwd = pwd_entry.get().strip()
+            if not new_pwd:
+                self._show_error("A senha n├úo pode estar vazia.")
+                return
+            try:
+                self.security_service.update_user_password(int(user["id"]), new_pwd)
+                pwd_dlg.destroy()
+                self._show_info("Senha atualizada com sucesso.")
+            except Exception as e:
+                self._show_error(str(e))
+
+        ctk.CTkButton(pwd_dlg, text="Salvar", command=save).pack(pady=30)
+
+    def logout(self) -> None:
